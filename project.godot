; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Game Foundation"
run/main_scene="res://addons/CoreUI/Examples/MainMenuRoot.tscn"
config/features=PackedStringArray("4.7", "C#", "Mobile")
config/icon="res://icon.svg"

[autoload]

MenuManager="*res://addons/CoreUI/Scripts/MenuManager.cs"
SceneFlowManager="*res://addons/CoreUI/Scripts/SceneFlowManager.cs"
SettingsManager="*res://addons/CoreUI/Scripts/SettingsManager.cs"
AudioManager="*res://addons/CoreUI/Scripts/AudioManager.cs"
PauseController="*res://addons/CoreUI/Scripts/PauseController.cs"
PhantomCameraManager="*uid://duq6jhf6unyis"
InputManager="*uid://bynjvib15i1t"
SaveManager="*uid://d3vwmuagai4jk"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="Main Menu"

[editor_plugins]

enabled=PackedStringArray("res://addons/phantom_camera/plugin.cfg")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
